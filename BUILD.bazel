# -*- python -*

load("//tools/lint:lint.bzl", "add_lint_tests")

genrule(
    name = "_copy_config",
    srcs = [
        "@drake//:.bazelproject",
        "@drake//:.clang-format",
        "@drake//:CPPLINT.cfg",
    ],
    outs = [
        ".bazelproject",
        ".clang-format",
        "CPPLINT.cfg",
    ],
    cmd = "for f in $(SRCS); do base=$$(basename $$f); if [ -f \"$$f\" ]; then cp \"$$f\" $(RULEDIR)/\"$$base\"; else : > $(RULEDIR)/\"$$base\"; fi; done",
    visibility = ["//visibility:public"],
)

